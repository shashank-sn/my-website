@@ -0,0 +1,65 @@
+name: Update Profile Stats
+
+on:
+  schedule:
+    - cron: "0 6 * * *"
+  workflow_dispatch:
+
+permissions:
+  contents: write
+
+jobs:
+  update-profile:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+
+      - name: Fetch latest GitHub stats
+        env:
+          GH_TOKEN: ${{ github.token }}
+        run: |
+          DATA=$(gh api graphql -f query='
+            query {
+              user(login: "shashank-sn") {
+                followers { totalCount }
+                repositories { totalCount }
+                contributionsCollection { totalCommitContributions }
+                repositories(ownerAffiliations: OWNER, first: 100) {
+                  nodes { stargazerCount }
+                }
+              }
+            }')
+          FOLLOWERS=$(echo "$DATA" | jq '.data.user.followers.totalCount')
+          REPOS=$(echo "$DATA" | jq '.data.user.repositories.totalCount')
+          COMMITS=$(echo "$DATA" | jq '.data.user.contributionsCollection.totalCommitContributions')
+          STARS=$(echo "$DATA" | jq '[.data.user.repositories.nodes[].stargazerCount] | add')
+          CREATED=$(gh api users/shashank-sn --jq .created_at)
+          python3 - <<PY
+          import json
+          from datetime import datetime, timezone
+          from pathlib import Path
+
+          created = datetime.fromisoformat("${CREATED}".replace("Z", "+00:00"))
+          now = datetime.now(timezone.utc)
+          years, days = divmod((now - created).days, 365)
+
+          stats = {
+              "uptime": f"{years} years, {days} days",
+              "repos": "${REPOS}",
+              "stars": "${STARS}",
+              "commits": "${COMMITS}",
+              "followers": "${FOLLOWERS}",
+          }
+          Path("assets/profile-stats.json").write_text(json.dumps(stats, indent=2) + "\n")
+          PY
+
+      - name: Regenerate profile SVG
+        run: python3 scripts/generate-profile-svg.py
+
+      - name: Commit updates
+        run: |
+          git config user.name "github-actions[bot]"
+          git config user.email "github-actions[bot]@users.noreply.github.com"
+          git add assets/profile-neofetch.svg assets/profile-stats.json
+          git diff --staged --quiet || git commit -m "chore: refresh profile neofetch stats"
+          git push
